{
  "name": "denue-mcp",
  "version": "1.0.0",
  "description": "MCP server for INEGI's open data — search Mexico's national business directory (DENUE, 5M+ establishments) and query official socioeconomic indicators (population, inflation, and more) from Claude and other AI agents.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "denue-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "test": "npm run build && node --test build/*.test.js",
    "prepublishOnly": "npm run build",
    "prepack": "rm -f build/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inegi",
    "denue",
    "indicadores",
    "mexico",
    "claude",
    "ai-agents"
  ],
  "author": "Manuel Bautista",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxnueel/denue-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mxnueel/denue-mcp/issues"
  },
  "homepage": "https://github.com/mxnueel/denue-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
